
// Workspace keybindings for quick task run
// ctrl+alt+b: Backend (tests & scans)
// ctrl+alt+f: Frontend (tests & scans)
// ctrl+alt+l: Lint (apply auto-fixes)
[

	{
		"key": "ctrl+alt+d",
		"command": "workbench.action.tasks.runTask",
		"args": "Build & Run Local Docker",
		"when": "editorTextFocus"
	},
	{
		"key": "ctrl+alt+b",
		"command": "workbench.action.tasks.runTask",
		"args": "Backend: Run All Tests & Scans",
		"when": "editorTextFocus"
	},
	{
		"key": "ctrl+alt+p",
		"command": "workbench.action.tasks.runTask",
		"args": "Run Pre-commit (Staged Files)",
		"when": "editorTextFocus"
	},
	{
		"key": "ctrl+alt+g",
		"command": "workbench.action.tasks.runTask",
		"args": "Lint: GolangCI-Lint",
		"when": "editorTextFocus"
	},
	{
		"key": "ctrl+alt+f",
		"command": "workbench.action.tasks.runTask",
		"args": "Frontend: Run All Tests & Scans",
		"when": "editorTextFocus"
	}
	,
	{
		"key": "ctrl+alt+l",
		"command": "workbench.action.tasks.runTask",
		"args": "Lint: Apply Fixes",
		"when": "editorTextFocus"
	}
]
