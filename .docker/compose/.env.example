# Charon Environment Variables

# Emergency "break-glass" token used to regain access when an ACL locks you out.
# Keep it secret and rotate it periodically. Generate with:
#   openssl rand -hex 32
CHARON_EMERGENCY_TOKEN=

# =============================================================================
# Orthrus Agent (optional, used by the orthrus service in these compose files)
# =============================================================================
# Plain-English guide: docs/features/orthrus.md

# User the agent runs as. Leave at 65532 unless you have a reason to change it.
# Never set this to 0 (the administrator account).
PUID=65532

# Group the agent runs as. Set it to your Docker socket's group so the agent can read it.
# Find it with: stat -c '%g' /var/run/docker.sock
PGID=

# Timezone for log timestamps (example: America/New_York)
TZ=UTC

# Path to the Docker socket on this machine (mounted read-only into the agent)
DOCKER_SOCK=/var/run/docker.sock

# Rootless Docker ONLY (leave commented out unless you run rootless Docker).
# If you use it, replace the PUID and PGID lines above with these, and set the
# number after /run/user/ to the output of `id -u`. Do NOT use these on normal
# (rootful) Docker: there, PUID=0 means real administrator.
# See docs/features/orthrus.md#rootless-docker
# PUID=0
# PGID=0
# ORTHRUS_ALLOW_ROOT=true
# DOCKER_SOCK=/run/user/1000/docker.sock

# Websocket address of your Charon server, e.g. wss://charon.example.com/api/v1/ws/orthrus/connect
ORTHRUS_SERVER_URL=

# Agent ID shown in Charon when you register the agent
ORTHRUS_AGENT_ID=

# One-time auth key from Charon. Leave blank here and paste your own key. Never commit a real key.
ORTHRUS_AUTH_KEY=
