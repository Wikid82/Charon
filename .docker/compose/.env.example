# Charon Environment Variables

# Emergency "break-glass" token used to regain access when an ACL locks you out.
# Keep it secret and rotate it periodically. Generate with:
#   openssl rand -hex 32
CHARON_EMERGENCY_TOKEN=

# Orthrus Environment Variables
 ORTHRUS_SERVER_URL=
 ORTHRUS_AGENT_ID=
 ORTHRUS_AUTH_KEY=
 DOCKER_SOCK=