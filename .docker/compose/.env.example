# Environment for docker-compose.local.yml
# Copy this file to .env in this directory (it is gitignored) and fill in the value.
# Compose reads .env from the compose file's directory automatically.

# Emergency "break-glass" token used to regain access when an ACL locks you out.
# Keep it secret and rotate it periodically. Generate with:
#   openssl rand -hex 32
CHARON_EMERGENCY_TOKEN=
