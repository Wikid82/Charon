{
  "name": "charon-frontend",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "tools": [],
  "constraints": [
    "NPM SCRIPTS ONLY: Do not try to construct complex `vitest` or `playwright` commands. Always look at `package.json` first and use `npm run <script-name>`."
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json && vite build",
    "pretype-check": "npm ci --silent --ignore-scripts",
    "type-check": "tsc --noEmit",
    "audit:ci": "audit-ci --config ./audit-ci.json",
    "lint": "eslint . --report-unused-disable-directives",
    "preview": "vite preview",
    "test": "NODE_OPTIONS=--max-old-space-size=4096 vitest run",
    "test:ci": "NODE_OPTIONS=--max-old-space-size=4096 vitest run",
    "test:ui": "vitest --ui",
    "check-coverage": "bash ../scripts/frontend-test-coverage.sh",
    "pretest:coverage": "npm ci --silent --ignore-scripts && node -e \"require('fs').mkdirSync('coverage/.tmp', { recursive: true })\"",
    "test:coverage": "NODE_OPTIONS=--max-old-space-size=4096 vitest run --coverage",
    "e2e:install": "npx playwright install --with-deps",
    "e2e:test": "playwright test",
    "e2e:up:block": "docker compose -f ../.docker/compose/docker-compose.local.yml down && CHARON_SECURITY_WAF_MODE=block docker compose -f ../.docker/compose/docker-compose.local.yml up -d",
    "e2e:up:monitor": "docker compose -f ../.docker/compose/docker-compose.local.yml down && CHARON_SECURITY_WAF_MODE=monitor docker compose -f ../.docker/compose/docker-compose.local.yml up -d",
    "e2e:down": "docker compose -f ../.docker/compose/docker-compose.local.yml down"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.105.0",
    "axios": "^1.21.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "i18next": "^26.5.11",
    "i18next-browser-languagedetector": "^8.2.3",
    "i18next-resources-to-backend": "^1.2.3",
    "lucide-react": "^1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-hot-toast": "^2.6.1",
    "react-i18next": "^17.1.9",
    "react-router": "^8.5.1",
    "react-router-dom": "^7.18.5",
    "react-router-hash-link": "^2.4.3",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "tldts": "^7.4.19"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/css": "^2.0.1",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.1",
    "@eslint/markdown": "^8.0.3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/eslint-plugin-jsx-a11y": "6.10.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@typescript-eslint/utils": "^8.72.1",
    "@typescript/native": "npm:typescript@^7.1.0-dev.20261023.1",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-istanbul": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/eslint-plugin": "^1.6.28",
    "@vitest/ui": "^5.0.5",
    "audit-ci": "^7.1.0",
    "eslint": "^10.13.0",
    "eslint-formatter-compact": "^9.0.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-i18n-json": "^4.0.1",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-security": "^4.2.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-unicorn": "^79.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jsdom": "^30.1.3",
    "knip": "^6.43.0",
    "playwright": "^1.64.1",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zod-validation-error": "^5.0.0"
  },
  "engines": {
    "node": "26.13.0"
  },
  "overrides": {
    "eslint-plugin-react-hooks": {
      "eslint": "^10.13.0"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "^10.13.0"
    },
    "eslint-plugin-promise": {
      "eslint": "^10.13.0"
    },
    "@vitejs/plugin-react": {
      "vite": "^8.3.5"
    },
    "katex": "^0.19.1"
  },
  "allowScripts": {
    "unrs-resolver": false
  }
}
