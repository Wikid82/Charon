# Charon Environment Configuration Example
# =========================================
# Copy this file to .env and configure with your values.
# Never commit your actual .env file to version control.

# =============================================================================
# Required Configuration
# =============================================================================

# Database encryption key - 32 bytes base64 encoded
# Generate with: openssl rand -base64 32
CHARON_ENCRYPTION_KEY=

# =============================================================================
# Emergency Reset Token (Break-Glass Recovery)
# =============================================================================

# Emergency reset token - REQUIRED for E2E tests (64 characters minimum)
# Used for break-glass recovery when locked out by ACL or other security modules.
# This token allows bypassing all security mechanisms to regain access.
#
# SECURITY WARNING: Keep this token secure and rotate it periodically (quarterly recommended).
# Only use this endpoint in genuine emergency situations.
# Never commit actual token values to the repository.
#
# Generate with (Linux/macOS):
#   openssl rand -hex 32
#
# Generate with (Windows PowerShell):
#   [Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
#
# Generate with (Node.js - all platforms):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# REQUIRED for E2E tests - add to .env file (gitignored) or CI/CD secrets
#
# REQUIRED for .docker/compose/docker-compose.local.yml - Compose refuses to start
# without it. That compose file reads .env from its own directory; use the template
# at .docker/compose/.env.example (copy it to .docker/compose/.env).
CHARON_EMERGENCY_TOKEN=

# =============================================================================
# Optional Configuration
# =============================================================================

# Server port (default: 8080)
# CHARON_HTTP_PORT=8080

# Database path (default: /app/data/charon.db)
# CHARON_DB_PATH=/app/data/charon.db

# Automatic database optimization at startup: auto | off (default: auto).
# With auto, a database with a lot of reusable space is optimized once at the next
# start. The management UI, API and emergency server answer 503 while that runs
# (proxied traffic is not affected). Set off to skip it and regain break-glass access.
# CHARON_DB_COMPACT_ON_START=auto

# Enable debug mode (default: 0)
# CHARON_DEBUG=0

# Use ACME staging environment (default: false)
# CHARON_ACME_STAGING=false

# =============================================================================
# Orthrus Agent (optional)
# =============================================================================
# Orthrus is a small helper that runs on the machine whose containers you want
# Charon to see. Its settings go in the .env file next to the Orthrus compose file;
# they are listed here so you can see them all in one place.
# Plain-English guide: docs/features/orthrus.md

# User the agent runs as. Leave at 65532 unless you have a reason to change it.
# Never set this to 0 (the administrator account).
PUID=65532

# Group the agent runs as. Set it to your Docker socket's group so the agent can read it.
# Find it on that machine with: stat -c '%g' /var/run/docker.sock
PGID=

# Timezone for log timestamps (example: America/New_York)
TZ=UTC

# Path to the Docker socket on that machine (mounted read-only into the agent)
DOCKER_SOCK=/var/run/docker.sock

# Rootless Docker ONLY (leave commented out unless you run rootless Docker).
# If you use it, replace the PUID and PGID lines above with these, and set the
# number after /run/user/ to the output of `id -u`. Do NOT use these on normal
# (rootful) Docker: there, PUID=0 means real administrator.
# See docs/features/orthrus.md#rootless-docker
# PUID=0
# PGID=0
# ORTHRUS_ALLOW_ROOT=true
# DOCKER_SOCK=/run/user/1000/docker.sock

# Websocket address of your Charon server, e.g. wss://charon.example.com/api/v1/ws/orthrus/connect
ORTHRUS_SERVER_URL=

# Agent ID shown in Charon when you register the agent
ORTHRUS_AGENT_ID=

# The agent auth key is not stored here. Save the key shown in Charon to a file named
# orthrus_auth_key next to your compose file (see docs/features/orthrus.md#keep-the-auth-key-in-a-file).
# Never commit a real key.
