{
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CodeQL",
          "rules": [
            {
              "id": "go/example-module-relative-rule",
              "defaultConfiguration": { "level": "warning" }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "go/example-module-relative-rule",
          "ruleIndex": 0,
          "level": "warning",
          "message": { "text": "Example finding whose SARIF path is module-relative, as a local scan (--source-root=backend) would produce, not repo-root-relative like CI" },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "internal/api/handlers/foo.go" },
                "region": { "startLine": 42, "endLine": 42 }
              }
            }
          ]
        }
      ]
    }
  ]
}
