    "@mdx-js/react": "^3.1.1",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "react-router-hash-link": "^2.4.3"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
