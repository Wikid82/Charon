// markdownlint config for the pre-commit hook (scripts/pre-commit-hooks/markdownlint-staged.sh),
// `make lint-markdown`, and `npm run lint:md`.
{
  "default": true,
  // Rules turned off below stay off on purpose; each entry says why.
  "MD013": false, // line length: rewrapping prose is high churn for little value, and long table rows and URLs are unavoidable
  "MD036": false, // bold lead-in labels ("Who", "When", "Step 3: ...") are deliberate captions, not missing headings
  "MD025": {
    "front_matter_title": "" // docs-site pages carry a front-matter title and a matching "# Title"
  },
  "MD010": {
    "code_blocks": false // tabs are idiomatic in Go/Makefile snippets
  },
  "MD029": false, // numbered steps intentionally continue across interleaved code blocks (the rendered numbers are correct)
  "MD028": false, // adjacent callout blockquotes are separated by a blank line on purpose
  "MD024": {
    "siblings_only": true
  },
  "MD033": {
    "allowed_elements": ["details", "summary", "br", "sup", "sub", "kbd", "img", "p", "a", "h1", "strong", "em"]
  },
  "MD041": false,
  "MD046": {
    "style": "fenced"
  }
}
